# Copy this file to .env (gitignored) and fill in your own keys.
# NEVER commit real keys to the repository.

# Groq API key (console.groq.com) — powers avatar conversations, Whisper
# speech-to-text, AI lesson generation and feedback. Alternatively the key
# can be entered in-app: Profilo → Impostazioni AI.
EXPO_PUBLIC_GROQ_API_KEY=

# Firebase (optional — enables cloud sync, leaderboard, analytics, FCM).
# The app works fully offline without it.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
